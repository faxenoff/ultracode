{
  "name": "ultracode",
  "version": "5.15.0",
  "description": "Codebase RAG MCP server for code understanding - semantic search, duplicate detection, impact analysis for TS/JS/Python/C#/Go/Rust/Java/C++/Kotlin/Swift/Zig/Bash",
  "license": "AGPL-3.0-only OR Commercial",
  "author": "faxenoff",
  "homepage": "https://github.com/faxenoff/ultracode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faxenoff/ultracode.git"
  },
  "bugs": {
    "url": "https://github.com/faxenoff/ultracode/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-analysis",
    "graph",
    "rag",
    "llm",
    "agents",
    "coderag",
    "typescript",
    "vector-search",
    "semantic-search",
    "claude"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ultracode": "dist/index.js",
    "ultracode-cli": "bin/ultracode.js",
    "ultracode-setup": "bin/ultracode-setup.cjs",
    "ulog": "dist/cli/log-query/log-query-cli.js"
  },
  "files": [
    "bin/**/*.js",
    "bin/**/*.cjs",
    "dist/**/*.js",
    "dist/**/*.wasm",
    "dist/**/*.d.ts",
    "dist/**/*.proto",
    "dist/ultracode.com",
    "dist/ultracode-darwin-arm64",
    "dist/ultracode-darwin-x64",
    "dist/ultracode-linux-x64",
    "dist/ultracode-linux-arm64",
    "dist/ultracode-win32-x64.exe",
    "external-libs/**/*.node",
    "external-libs/**/*.dylib",
    "external-libs/**/*.dll",
    "external-libs/**/*.so*",
    "external-libs/**/*.metallib",
    "scripts/postinstall.sh",
    "scripts/postinstall.cjs",
    "scripts/build-native-libs-macos.sh",
    "scripts/setup.cmd",
    "scripts/setup.sh",
    "scripts/setup-semantic-embedding.ps1",
    "scripts/setup-tei.ps1",
    "scripts/setup-tei.sh",
    "scripts/setup-ollama.ps1",
    "scripts/detect-gpu-architecture.ps1",
    "config/embedding-models.json",
    "config/embedding-models.schema.json",
    "config/llm-models.json",
    "README.md",
    "LICENSE",
    "prompts/**/*.md",
    "claude-skills/**/*.md",
    "claude-skills/manifest.json",
    "dist/parsers/python-ast-cli.py",
    "dist/parsers/go-ast-cli.go",
    "dist/roslyn-addon/**",
    "dist/semantic/global-cache-prebuilt/**"
  ],
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs');const p=require('path');const d='dist';if(fs.existsSync(d)){fs.readdirSync(d).filter(f=>f.endsWith('.js')||f.endsWith('.js.map')||f.endsWith('.d.ts')||f.endsWith('.d.mts')).forEach(f=>fs.unlinkSync(p.join(d,f)));const chunks=p.join(d,'chunks');if(fs.existsSync(chunks)){fs.rmSync(chunks,{recursive:true,force:true})}const subdirs=['agents','utils','semantic','cli'];subdirs.forEach(s=>{const sp=p.join(d,s);if(fs.existsSync(sp))fs.rmSync(sp,{recursive:true,force:true})});console.log('[prebuild] Cleaned old build artifacts from dist/')}\"",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:full": "npm run build && npm run build:wasm && npm run build:global-cache",
    "build:native": "pwsh scripts/build-native-libs.ps1",
    "build:native:windows": "pwsh scripts/build-native-libs.ps1 -Platform windows",
    "build:native:linux": "pwsh scripts/build-native-libs.ps1 -Platform linux",
    "build:native:clean": "pwsh scripts/build-native-libs.ps1 -Clean",
    "build:cuda": "pwsh scripts/build-cuda.ps1 || (cd external-tools/native/cuda && cmake-js compile && cd ../../.. && mkdir -p dist/native/cuda && cp external-tools/native/cuda/build/Release/ultracode_cuda.node dist/native/cuda/)",
    "build:cuda:debug": "pwsh scripts/build-cuda.ps1 -Debug",
    "build:cuda:clean": "pwsh scripts/build-cuda.ps1 -Clean",
    "build:global-cache": "bun scripts/build-global-embeddings.ts",
    "build:faiss": "node scripts/build-faiss-node.js",
    "build:faiss:wsl": "pwsh scripts/build-faiss-wsl.ps1",
    "build:faiss:wsl:clean": "pwsh scripts/build-faiss-wsl.ps1 -Clean",
    "build:faiss:docker": "pwsh scripts/build-faiss-docker.ps1",
    "build:faiss:docker:clean": "pwsh scripts/build-faiss-docker.ps1 -Clean",
    "build:faiss:macos": "bash scripts/build-faiss-macos.sh",
    "build:faiss:cpu": "bash scripts/build-faiss-cpu.sh",
    "build:faiss:cpu:force": "bash scripts/build-faiss-cpu.sh --force",
    "build:roslyn": "pwsh scripts/build-roslyn.ps1",
    "build:roslyn:force": "pwsh scripts/build-roslyn.ps1 -Force",
    "build:roslyn:clean": "pwsh scripts/build-roslyn.ps1 -Clean",
    "build:comm": "pwsh src/comm/build.ps1",
    "build:comm:setup": "pwsh src/comm/setup.ps1",
    "build:standalone": "bun build --compile --bytecode dist/index.js --outfile dist/ultracode",
    "build:standalone:win": "bun build --compile --bytecode --target=bun-windows-x64 dist/index.js --outfile dist/ultracode.exe",
    "build:standalone:linux": "bun build --compile --bytecode --target=bun-linux-x64 dist/index.js --outfile dist/ultracode-linux",
    "build:standalone:mac": "bun build --compile --bytecode --target=bun-darwin-arm64 dist/index.js --outfile dist/ultracode-mac",
    "build:standalone:win-arm64": "bun build --compile --bytecode --target=bun-windows-arm64 dist/index.js --outfile dist/ultracode-arm64.exe",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:ci": "bun test --bail",
    "bench": "node benchmarks/benchmark-large-project.js && node benchmarks/benchmark-simd.js && node benchmarks/benchmark-workers.js",
    "bench:large": "node benchmarks/benchmark-large-project.js",
    "bench:simd": "node benchmarks/benchmark-simd.js",
    "bench:workers": "node benchmarks/benchmark-workers.js",
    "bun:start": "bun src/index.ts",
    "bun:dist": "bun dist/index.js",
    "ulog": "node dist/cli/log-query/log-query-cli.js",
    "debug:tools": "bun src/cli/debug-tools-visibility.ts",
    "smoke": "node scripts/smoke-graph-health.js /home/er77/_work_fodler/baserow-develop",
    "smoke:clean": "node scripts/smoke-graph-health.js /home/er77/_work_fodler/baserow-develop --clean",
    "smoke:semantic": "node scripts/smoke-semantic.js /home/er77/_work_fodler/baserow-develop",
    "clean": "rm -rf dist",
    "postinstall": "node scripts/postinstall.cjs",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@oxc-project/types": "^0.143.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "antlr4ng": "^3.0.16",
    "antlr4ng-cli": "^2.0.0",
    "cmake-js": "^8.0.0",
    "husky": "^9.1.7",
    "node-addon-api": "^8.9.1",
    "node-gyp": "^13.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@biomejs/biome": "^2.5.7",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@huggingface/inference": "^4.13.25",
    "@lenml/tokenizers": "^3.7.2",
    "better-sqlite3": "^13.0.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cbor-x": "^1.6.5",
    "fast-glob": "^3.3.3",
    "fast-json-stringify": "^7.0.1",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-metrics": "^2.4.0",
    "graphology-operators": "^1.6.1",
    "graphology-shortest-path": "^2.1.0",
    "graphology-types": "^0.24.8",
    "java-parser": "^3.0.1",
    "lru-cache": "^11.5.2",
    "nanoid": "^6.0.1",
    "oxc-parser": "^0.143.0",
    "oxlint": "^1.77.0",
    "p-limit": "^7.3.1",
    "protobufjs": "^8.7.1",
    "tslib": "^2.8.1",
    "xxhash-wasm": "^1.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@webgpu/node": "npm:null@^2.0.0",
    "@webgpu/types": "^0.1.71",
    "webgpu": "^0.4.0",
    "7zip-min": "^3.0.1"
  },
  "overrides": {
    "boolean": "3.2.0",
    "hono": "4.12.7",
    "@hono/node-server": "1.19.11",
    "minimatch": "10.2.4",
    "rollup": "4.59.0",
    "tar": "7.5.11",
    "qs": "6.15.0",
    "ajv": "8.18.0",
    "express-rate-limit": "8.3.1",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "@isaacs/brace-expansion": "5.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "notes": {
    "boolean@3.2.0": "Deprecated transitive dependency. Package is unmaintained but functional.",
    "lenml-tokenizers": "@lenml/tokenizers - lightweight tokenizer (~2MB) without ONNX runtime. Inference is done by external services (OVMS, TEI, vLLM).",
    "faiss-napi": "REMOVED — replaced by native FAISS addon in ultracode_cuda.node (ENABLE_FAISS_CPU). faiss-napi v0.10.3 train() crashes on IVF indexes.",
    "libsql-client": "REMOVED — replaced by better-sqlite3 (Node) / bun:sqlite (Bun). Local-only project, async IPC overhead was unnecessary."
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "better-sqlite3",
    "cbor-extract",
    "protobufjs",
    "webgpu"
  ]
}
